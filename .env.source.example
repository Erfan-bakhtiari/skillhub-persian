# Copy to ignored .env.source and replace all REPLACE_WITH values.
SKILLHUB_VERSION=source-persian
SKILLHUB_SERVICE_VERSION=source-persian
SKILLHUB_SERVER_IMAGE=skillhub-persian-server
SKILLHUB_WEB_IMAGE=skillhub-persian-web
SKILLHUB_SCANNER_IMAGE=skillhub-persian-scanner
SKILLHUB_PUBLIC_BASE_URL=http://localhost:3000
SKILLHUB_WEB_API_BASE_URL=
SKILLHUB_API_UPSTREAM=http://server:8080
SKILLHUB_TRUST_FORWARDED_PROTO=false
API_PORT=8080
WEB_PORT=3000
POSTGRES_DB=skillhub
POSTGRES_USER=skillhub
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
SESSION_COOKIE_SECURE=false
SKILLHUB_STORAGE_PROVIDER=local
SKILLHUB_DOWNLOAD_ANON_COOKIE_SECRET=REPLACE_WITH_RANDOM_COOKIE_SECRET_AT_LEAST_32_CHARACTERS
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USER_ID=source-admin
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
SKILLHUB_BUILTIN_SKILLS_ENABLED=true
